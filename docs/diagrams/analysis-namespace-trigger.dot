digraph namespace_trigger {
  graph [rankdir=LR, fontsize=11, labelloc=t, label="Namespace Incident Analysis Trigger"];
  node [shape=box, style="rounded,filled", fillcolor="#fff8ef", color="#c27c2c", fontname="Arial", fontsize=10];
  edge [color="#4a4a4a", fontname="Arial", fontsize=9];

  monitor [label="WatcherService._namespace_monitor_loop()\ninterval from config"];
  detect [label="Detect namespace issue\ncurrently: stuck terminating"];
  limits [label="Rate-limit checks\nper namespace and cluster"];
  incident [label="NamespaceIncidentRepo.create()\nstatus=ACTIVE"];
  job [label="_create_investigation_job()\nInvestigationJob(type=namespace)"];
  worker [label="AnalysisWorker._process_namespace_jobs()\nevery 15s"];
  status [label="incident status -> INVESTIGATING"];
  agent [label="InvestigatorAgent.investigate_namespace()"];
  store [label="NamespaceIncidentRepo.append_analysis()\nanalysis_status=DONE"];
  slack [label="SlackNotifier.send_analysis()"];
  done [label="AlertRepo.update_job_status(completed)"];

  monitor -> detect -> limits;
  limits -> incident [label="within limits"];
  incident -> job -> worker -> status -> agent -> store -> slack -> done;
}
