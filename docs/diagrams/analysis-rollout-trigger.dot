digraph rollout_trigger {
  graph [rankdir=LR, fontsize=11, labelloc=t, label="Automatic Rollout Analysis Trigger"];
  node [shape=box, style="rounded,filled", fillcolor="#eef6ff", color="#4472c4", fontname="Arial", fontsize=10];
  edge [color="#4a4a4a", fontname="Arial", fontsize=9];

  k8s [label="Kubernetes deployment\nevent (ADDED/MODIFIED)"];
  watch [label="WatcherService._watch_loop()\nhandle_deployment_event()"];
  create [label="Create or refresh rollout row\nstatus=PENDING/ROLLING_OUT"];
  reconcile [label="WatcherService._reconcile_loop()\nreconcile_rollout()\nevery 10s"];
  fail [label="Failure detected\n- early permanent pod failure\n- Progressing=False\n- rollout timeout"];
  queue [label="RolloutRepo.queue_for_analysis()\nanalysis_status=PENDING"];
  worker [label="AnalysisWorker._process_rollouts()\nevery 15s"];
  gate [label="Actionability checks\n- namespace still exists\n- not terminating\n- deployment not recovered"];
  agent [label="InvestigatorAgent.investigate()"];
  slack [label="SlackNotifier.send_analysis()"];
  persist [label="RolloutRepo.append_analysis()\nanalysis_status=DONE"];
  discard [label="RolloutRepo.discard_analysis()\nanalysis_status=DISCARDED"];

  k8s -> watch -> create -> reconcile;
  reconcile -> fail [label="if failed"];
  fail -> queue -> worker -> gate;
  gate -> agent [label="still actionable"];
  gate -> discard [label="deleted / terminating / recovered"];
  agent -> slack -> persist;
}
