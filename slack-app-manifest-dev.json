{
  "display_information": {
    "name": "fyr-dev",
    "description": "Fyr Dev - Kubernetes Rollout Intelligence for the Dev cluster",
    "background_color": "#2F855A",
    "long_description": "Fyr Dev monitors the Dev Kubernetes cluster and provides AI-powered analysis of failures. Get instant notifications, run investigations with slash commands, and chat with AI about cluster issues in the Dev environment."
  },
  "features": {
    "app_home": {
      "home_tab_enabled": true,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "Fyr Dev",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/fyr",
        "description": "Dev cluster intelligence and investigation",
        "usage_hint": "[status|namespace <ns>|investigate <ns> [deploy]|recent|help]",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "chat:write",
        "chat:write.public",
        "commands",
        "files:write",
        "groups:history",
        "im:history",
        "im:write",
        "users:read",
        "users:read.email"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_home_opened",
        "app_mention",
        "message.im"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": true,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
